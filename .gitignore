# Environment and local secrets
.env
.env.*
backend/.env
!backend/.env.example

# Python environments and cache
.venv/
venv/
env/
backend/.venv/
backend/venv/
**/__pycache__/
*.py[cod]
*$py.class

# Node dependencies and build output
node_modules/
dist/
build/
frontend/**/dist/
frontend/**/build/

# Logs and runtime output
*.log
logs/
backend/logs/
backend/outputs/

# IDE and system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Private keys and certificates
*.pem
*.key
id_rsa
id_rsa.pub

# Local databases, vector stores, and generated data
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
postgres_data/
qdrant_storage/

# Temporary files, upload cache, and local screenshots
tmp/
temp/
.cache/
/uploads/
/backend/uploads/
backend/data/uploads/*
!backend/data/uploads/.gitkeep
!backend/data/uploads/avatars/
backend/data/uploads/avatars/*
!backend/data/uploads/avatars/.gitkeep
!backend/data/uploads/avatars/user/
!backend/data/uploads/avatars/characters/
backend/data/uploads/avatars/user/*
backend/data/uploads/avatars/characters/*
!backend/data/uploads/avatars/user/.gitkeep
!backend/data/uploads/avatars/characters/.gitkeep
image/

# Local voice/raw assets that may contain private user data
raw/
backend/raw/
backend/data/voice_refs/**/*.wav
backend/data/voice_refs/**/*.mp3
backend/data/voice_refs/**/*.flac
backend/data/voice_clean/

# Character module local assets and safety backups
backend/modules/characters/packs/*/backups/*
