APP_NAME="虚拟人物陪伴系统"
APP_VERSION="0.1.0"
DEFAULT_CHARACTER_ID="role01"
DATA_DIR="./data"
OUTPUTS_DIR="./outputs"
UPLOAD_DIR="./data/uploads"
DATABASE_URL="postgresql://your_db_user:your_db_password@127.0.0.1:5432/your_db_name"
FRONTEND_DIR="../frontend/simple_web"

# 通用兼容配置，旧版本兼容用。新功能优先使用 CHAT_* 和 PERSONA_EDITOR_*。
LLM_PROVIDER="openai"
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
OPENAI_MODEL="your_default_model_here"
OPENAI_TIMEOUT_SECONDS="60"
OPENAI_TEMPERATURE="0.8"

# 普通聊天模型：负责角色回复生成。
CHAT_LLM_PROVIDER="openai"
CHAT_OPENAI_API_KEY="your_api_key_here"
CHAT_OPENAI_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
CHAT_OPENAI_MODEL="your_chat_model_here"
CHAT_OPENAI_TIMEOUT_SECONDS="60"
CHAT_OPENAI_TEMPERATURE="0.8"

# 人设编辑模型：负责分析反馈、讨论修改方案、生成 preview_character_json。
PERSONA_EDITOR_LLM_PROVIDER="openai"
PERSONA_EDITOR_OPENAI_API_KEY="your_api_key_here"
PERSONA_EDITOR_OPENAI_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
PERSONA_EDITOR_OPENAI_MODEL="your_persona_editor_model_here"
PERSONA_EDITOR_OPENAI_TIMEOUT_SECONDS="60"
PERSONA_EDITOR_OPENAI_TEMPERATURE="0.3"

# Set true only when you want /chat/text debug to include the full prompt.
DEBUG_PROMPT="false"
JWT_SECRET_KEY="change_this_to_a_long_random_string"
JWT_EXPIRE_MINUTES="10080"
AVATAR_MAX_SIZE_MB="5"

# Character pack retrieval settings.
TOP_K_LORE="5"
TOP_K_DIALOGUE="5"
TOP_K_REACTION="3"
TOP_K_MEMORY="5"
STYLE_SCORE_THRESHOLD="8.0"

# Future local GPT-SoVITS settings.
GPTSOVITS_BASE_URL="http://127.0.0.1:9880"
GPTSOVITS_TIMEOUT_SECONDS="120"
