APP_NAME="Local Role Voice Chatbot"
APP_VERSION="0.1.0"
DEFAULT_CHARACTER_ID="role01"
DATA_DIR="./data"
OUTPUTS_DIR="./outputs"
DATABASE_URL="postgresql://your_db_user:your_db_password@127.0.0.1:5432/your_db_name"
FRONTEND_DIR="../frontend/simple_web"

# LLM_PROVIDER:
# - auto: use OpenAI-compatible API only when OPENAI_API_KEY and OPENAI_MODEL are set
# - mock: always use local mock candidates
# - openai / openai_compatible / ark: require OpenAI-compatible API settings
LLM_PROVIDER="auto"

# OpenAI-compatible API settings. Do not put real keys in this example file.
# OPENAI_BASE_URL should be a base URL, for example:
# https://ark.cn-beijing.volces.com/api/v3
# Do not include /chat/completions.
OPENAI_API_KEY="your_api_key_here"
OPENAI_BASE_URL="https://your-openai-compatible-base-url.example.com/api/v3"
OPENAI_MODEL="your_model_name_here"
OPENAI_TIMEOUT_SECONDS="60"
OPENAI_TEMPERATURE="0.8"

# Set true only when you want /chat/text debug to include the full prompt.
DEBUG_PROMPT="false"

# Local JSONL retrieval settings.
TOP_K_LORE="5"
TOP_K_DIALOGUE="5"
TOP_K_REACTION="3"
TOP_K_MEMORY="5"
STYLE_SCORE_THRESHOLD="8.0"

# Future local GPT-SoVITS settings.
GPTSOVITS_BASE_URL="http://127.0.0.1:9880"
GPTSOVITS_TIMEOUT_SECONDS="120"
